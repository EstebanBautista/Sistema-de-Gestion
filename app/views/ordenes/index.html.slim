.d-flex.justify-content-between.align-items-center.mb-4
  h1.mb-0
    i.bi.bi-list-task.me-2
    | Órdenes de Servicio
  = link_to new_orden_path, class: "btn btn-primary" do
    i.bi.bi-plus-lg.me-1
    | Nueva Orden

.card.shadow-sm.mb-4
  .card-body.py-3
    = form_with url: ordenes_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      .col-md-2
        = f.label :q, "Buscar:", class: "form-label small mb-1"
        = f.text_field :q, value: params[:q], class: "form-control form-control-sm", placeholder: "Folio o título..."
      .col-md-2
        = f.label :estado, "Estado:", class: "form-label small mb-1"
        = f.select :estado, options_for_select([["Todas", ""], ["Pendiente", "pendiente"], ["En Progreso", "en_progreso"], ["Completada", "completada"]], params[:estado]), {}, class: "form-select form-select-sm"
      .col-md-3
        = f.label :cliente_id, "Cliente:", class: "form-label small mb-1"
        = f.collection_select :cliente_id, Cliente.kept.order(:nombre), :id, :nombre, { include_blank: "Todos", selected: params[:cliente_id].to_i }, class: "form-select form-select-sm"
      .col-md-2
        = f.label :fecha_desde, "Desde:", class: "form-label small mb-1"
        = f.date_field :fecha_desde, value: params[:fecha_desde], class: "form-control form-control-sm"
      .col-md-2
        = f.label :fecha_hasta, "Hasta:", class: "form-label small mb-1"
        = f.date_field :fecha_hasta, value: params[:fecha_hasta], class: "form-control form-control-sm"
      .col-md-auto.d-flex.align-items-end
        = f.submit "Filtrar", class: "btn btn-sm btn-outline-primary"
        - if params[:q].present? || params[:estado].present? || params[:cliente_id].present? || params[:fecha_desde].present? || params[:fecha_hasta].present?
          = link_to ordenes_path, class: "btn btn-sm btn-outline-secondary ms-1" do
            i.bi.bi-x-lg

.card.shadow-sm
  .card-body.p-0.scrollable-table
    table.table.table-hover.mb-0
      thead.table-dark
        tr
          th Folio
          th Título
          th Cliente
          th Estado
          th Creada
          th.col-2 Acciones
      tbody
        - if @ordenes.any?
          - @ordenes.each do |orden|
            tr
              td.fw-bold.text-primary = link_to orden.folio, orden, class: "text-decoration-none"
              td = orden.titulo
              td = link_to orden.cliente.nombre, orden.cliente, class: "text-decoration-none"
              td = badge_estado(orden)
              td = l(orden.created_at, format: :short)
              td
                .d-flex.gap-1
                  = link_to orden, class: "btn btn-outline-secondary btn-sm" do
                    i.bi.bi-eye
                  = link_to edit_orden_path(orden), class: "btn btn-outline-primary btn-sm" do
                    i.bi.bi-pencil
                  = link_to "#", class: "btn btn-outline-danger btn-sm",
                    data: { bs_toggle: "modal", bs_target: "#confirmModal",
                            url: archivar_orden_path(orden),
                            method: "patch",
                            message: "¿Estás seguro de archivar la orden #{orden.folio}?" } do
                    i.bi.bi-archive
        - else
          tr
            td.text-center.text-muted.py-4 colspan="6" No hay órdenes registradas.

- if @ordenes.any?
  .d-flex.justify-content-center.mt-3
    = paginate @ordenes
