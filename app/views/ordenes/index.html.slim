.d-flex.justify-content-between.align-items-center.mb-4
  h1.mb-0
    i.bi.bi-list-task.me-2
    | Órdenes de Servicio
  = link_to new_orden_path, class: "btn btn-primary" do
    i.bi.bi-plus-lg.me-1
    | Nueva Orden

.card.shadow-sm.mb-4
  .card-body.py-3
    = form_with url: ordenes_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      .col-auto
        = f.label :estado, "Filtrar por estado:", class: "form-label small mb-1"
        = f.select :estado, options_for_select([["Todas", ""], ["Pendiente", "pendiente"], ["En Progreso", "en_progreso"], ["Completada", "completada"]], params[:estado]), {}, class: "form-select form-select-sm"
      .col-auto
        = f.submit "Filtrar", class: "btn btn-sm btn-outline-primary"
        - if params[:estado].present?
          = link_to ordenes_path, class: "btn btn-sm btn-outline-secondary ms-1" do
            i.bi.bi-x-lg

.card.shadow-sm
  .card-body.p-0
    table.table.table-hover.mb-0
      thead.table-dark
        tr
          th Folio
          th Título
          th Cliente
          th Estado
          th Creada
          th.col-2 Acciones
      tbody
        - if @ordenes.any?
          - @ordenes.each do |orden|
            tr
              td.fw-bold.text-primary = link_to orden.folio, orden, class: "text-decoration-none"
              td = orden.titulo
              td = link_to orden.cliente.nombre, orden.cliente, class: "text-decoration-none"
              td = badge_estado(orden)
              td = l(orden.created_at, format: :short)
              td
                .btn-group.btn-group-sm
                  = link_to orden, class: "btn btn-outline-secondary" do
                    i.bi.bi-eye
                  = link_to edit_orden_path(orden), class: "btn btn-outline-primary" do
                    i.bi.bi-pencil
                  = button_to archivar_orden_path(orden), method: :patch, class: "btn btn-outline-danger", data: { turbo_confirm: "¿Archivar esta orden?" } do
                    i.bi.bi-archive
        - else
          tr
            td.text-center.text-muted.py-4 colspan="6" No hay órdenes registradas.

- if @ordenes.any?
  .d-flex.justify-content-center.mt-3
    = paginate @ordenes
