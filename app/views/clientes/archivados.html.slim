.d-flex.justify-content-between.align-items-center.mb-4
  h1.mb-0
    i.bi.bi-archive.me-2
    | Clientes Archivados
  = link_to clientes_path, class: "btn btn-outline-secondary" do
    i.bi.bi-arrow-left.me-1
    | Clientes Activos

.card.shadow-sm.mb-4
  .card-body.py-3
    = form_with url: archivados_clientes_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      .col-md-3
        = f.label :fecha_desde, "Archivado desde:", class: "form-label small mb-1"
        = f.date_field :fecha_desde, value: params[:fecha_desde], class: "form-control form-control-sm"
      .col-md-3
        = f.label :fecha_hasta, "Archivado hasta:", class: "form-label small mb-1"
        = f.date_field :fecha_hasta, value: params[:fecha_hasta], class: "form-control form-control-sm"
      .col-md-auto
        = f.submit "Filtrar", class: "btn btn-sm btn-outline-primary"
        - if params[:fecha_desde].present? || params[:fecha_hasta].present?
          = link_to archivados_clientes_path, class: "btn btn-sm btn-outline-secondary ms-1" do
            i.bi.bi-x-lg

.card.shadow-sm
  .card-body.p-0
    table.table.table-hover.mb-0
      thead.table-dark
        tr
          th Nombre
          th Correo
          th Teléfono
          th Archivado el
          th.col-2 Acciones
      tbody
        - if @clientes.any?
          - @clientes.each do |cliente|
            tr
              td = link_to cliente.nombre, cliente, class: "text-decoration-none fw-medium"
              td = cliente.correo
              td = cliente.telefono
              td
                span.badge.bg-secondary
                  i.bi.bi-clock.me-1
                  = l(cliente.deleted_at, format: :short)
              td
                .d-flex.gap-1
                  = link_to cliente, class: "btn btn-outline-secondary btn-sm" do
                    i.bi.bi-eye
                  = link_to "#", class: "btn btn-outline-success btn-sm",
                    data: { bs_toggle: "modal", bs_target: "#confirmModal",
                            url: desarchivar_cliente_path(cliente),
                            method: "patch",
                            message: "¿Estás seguro de restaurar a #{cliente.nombre}?" } do
                    i.bi.bi-arrow-counterclockwise.me-1
                    | Restaurar
        - else
          tr
            td.text-center.text-muted.py-4 colspan="5" No hay clientes archivados.

- if @clientes.any?
  .d-flex.justify-content-center.mt-3
    = paginate @clientes
